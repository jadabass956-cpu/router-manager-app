// TPLinkRouter الكامل — نسخة JS من src/drivers/tplink/index.js
(function() {
  'use strict';

  const EP = {
    auth: { login: '/login.cgi', logout: '/logout.cgi', check: '/index.htm' },
    devices: { wifiClients: '/wlstatbl.htm', dhcpClients: '/dhcptbl.htm' },
    macFilter: {
      page: '/wlactrl.htm', form: '/form2WlAc.cgi',
      modeField: 'wlanAcEnabled', addAction: 'addFilterMac',
      delAction: 'deleteSelFilterMac', selField: 'select',
      submitField: 'submit.htm?wlactrl.htm',
    },
    wifi: {
      basicPage: '/wlbasic.htm', securityPage: '/wlwpa.htm',
      setupForm: '/form2WlanSetup.cgi', securityForm: '/form2WlEncrypt.cgi',
    },
    reboot: {
      page: '/reboot.htm', form: '/form2Reboot.cgi',
      field: 'save', value: 'Reboot', submitField: 'submit.htm?reboot.htm',
    },
    wan: { page: '/wan.htm' },
    wanForms: {
      phyForm: '/form2WanPhy.cgi', adslForm: '/form2WanAdsl.cgi',
      drouteForm: '/form2DrouteMechanism.cgi',
    },
    time: {
      page: '/time.htm', timeForm: '/form2systime.cgi',
      ntpForm: '/form2ntp.cgi', ntpStartForm: '/form2ntpstart.cgi',
    },
    basicFields: {
      ssid: 'ssid', band: 'band', mode: 'mode', chanwid: 'chanwid',
      chan: 'chan', txpower: 'txpower', basicrates: 'basicrates',
      operrates: 'operrates', submit: 'submit.htm?wlbasic.htm',
    },
    securityFields: {
      method: 'method', pskValue: 'pskValue', pskFormat: 'pskFormat',
      wpaAuth: 'wpaAuth', wpaSSID: 'wpaSSID', checkWPS2: 'checkWPS2',
      submit: 'submit.htm?wlwpa.htm',
    },
    encryptionMap: {
      'None': 0, 'WEP': 1, 'WPA-TKIP': 2, 'WPA-AES': 3, 'WPA2-AES': 4,
      'WPA2-TKIP': 5, 'WPA2-Mixed': 6, 'WPA3': 7, 'WPA3-Mixed': 8,
    },
    methodToName: {
      0: 'None', 1: 'WEP', 2: 'WPA-TKIP', 3: 'WPA-AES', 4: 'WPA2-AES',
      5: 'WPA2-TKIP', 6: 'WPA2-Mixed', 7: 'WPA3', 8: 'WPA3-Mixed',
    },
  };

  const md5 = (s) => window.MD5(s);
  const fmt = (hex) => hex.toLowerCase().match(/.{2}/g).join(':');
  const form = (o) => Object.entries(o).map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v)).join('&');

  // ═══════════ HTML Parsing ═══════════
  function rows(html) {
    return [...html.matchAll(/<tr[^>]*>([\s\S]*?)<\/tr>/gi)].map(r =>
      [...r[1].matchAll(/<td[^>]*>([\s\S]*?)(?=<\/td>|<td|$)/gi)].map(c =>
        c[1].replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').trim()
      )
    );
  }

  function mac(v) {
    const h = (v || '').replace(/[^0-9a-fA-F]/g, '');
    return h.length === 12 ? fmt(h) : null;
  }

  function normalizeMac(input) {
    const h = String(input || '').replace(/[^0-9a-fA-F]/g, '').toLowerCase();
    if (h.length !== 12 || /^0+$/.test(h)) throw new Error('INVALID_MAC');
    if (parseInt(h.slice(0, 2), 16) & 1) throw new Error('INVALID_MAC');
    return h;
  }

  function field(html, name) {
    if (!name) return null;
    const esc = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    let m = html.match(new RegExp('<input[^>]*?name\\s*=\\s*["\']?' + esc + '["\']?[^>]*?value\\s*=\\s*["\']([^"\']*)["\']', 'i'));
    if (m) return m[1];
    m = html.match(new RegExp('<input[^>]*?value\\s*=\\s*["\']([^"\']*)["\'][^>]*?name\\s*=\\s*["\']?' + esc + '["\']?', 'i'));
    if (m) return m[1];
    const sel = html.match(new RegExp('<select[^>]*?name\\s*=\\s*["\']?' + esc + '["\']?[^>]*>([\\s\\S]*?)<\\/select>', 'i'));
    if (sel) {
      const s = sel[1].match(/<option[^>]*value\s*=\s*["\']?([^"\'\s>]*)["\']?[^>]*selected/i);
      if (s) return s[1];
      const f = sel[1].match(/<option[^>]*value\s*=\s*["\']?([^"\'\s>]*)["\']?/i);
      if (f) return f[1];
    }
    return null;
  }

  // ═══════════ Class ═══════════
  class TPLinkRouter {
    constructor({ host, username, password }) {
      this.host = String(host || '').replace(/^https?:\/\//, '').replace(/\/$/, '');
      this.username = String(username || '');
      this.password = String(password || '');
      this.base = 'http://' + this.host;
    }

    _sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    async _post(path, body) {
      await this._req(path, { method: 'POST', body });
      // الراوتر يعيد تشغيل HTTP بعد التعديلات — ننتظر 3 ثواني
      await this._sleep(3000);
    }

    async _req(path, opts) {
      try {
        const url = this.base + path;
        if (opts && opts.method === 'POST') {
          return await window.http.post(url, opts.body);
        }
        return await window.http.get(url);
      } catch (e) {
        throw new Error(e.message === 'TIMEOUT' ? 'TIMEOUT' : 'ROUTER_UNREACHABLE');
      }
    }

    async login() {
      const body = form({
        usernameEncrypt: md5(this.username),
        passwordEncrypt: md5(this.password),
        'submit.htm?login.htm': 'Send',
      });
      await this._req(EP.auth.login, { method: 'POST', body });
      const check = await this._req(EP.auth.check);
      if (/login\.htm/i.test(check.body) && check.body.length < 400) {
        throw new Error('INVALID_CREDENTIALS');
      }
      return true;
    }

    async logout() {
      try {
        await this._req(EP.auth.logout, { method: 'POST', body: form({ 'submit.htm?index.htm': 'Send' }) });
      } catch (e) {}
    }

    // ── Devices ──
    async getDevices() {
      const [wifi, dhcp] = await Promise.all([
        this._req(EP.devices.wifiClients),
        this._req(EP.devices.dhcpClients),
      ]);
      const map = new Map();

      for (const cells of rows(dhcp.body)) {
        const ip = cells.find(c => /^(\d{1,3}\.){3}\d{1,3}$/.test(c));
        if (!ip) continue;
        const m = cells.map(mac).find(Boolean) || null;
        map.set(m || ip, { mac: m, ip, expires: cells[cells.length - 1], wifi: null });
      }

      for (const cells of rows(wifi.body)) {
        const m = mac(cells[0]);
        if (!m) continue;
        const wifi2 = { tx: cells[1], rx: cells[2], rate: cells[3] };
        const dev = map.get(m) || { mac: m, ip: null, expires: null, wifi: null };
        dev.wifi = wifi2;
        map.set(m, dev);
      }
      return [...map.values()];
    }

    // ── MAC Filter ──
    async getMacFilter() {
      const page = await this._req(EP.macFilter.page);
      const macs = [...page.body.matchAll(/<input[^>]*type=["']radio["'][^>]*name=["']select["'][^>]*value=["']([0-9a-fA-F]{12})["']/gi)].map(m => fmt(m[1]));
      const idxMatch = page.body.match(/wlanAcEnabled\.selectedIndex\s*=\s*(\d+)/);
      const idx = idxMatch ? Number(idxMatch[1]) : 0;
      const mode = ['disabled', 'allow', 'deny'][idx] || 'disabled';
      return { mode, macs };
    }

    async addMac(input) {
      const m = normalizeMac(input);
      const target = fmt(m);
      const current = await this.getMacFilter();
      if (current.macs.includes(target)) return { ...current, added: false };
      const backend = (window.appStore.getCredentials() || {}).backendMac;
      const backendHex = (backend || '').replace(/[^0-9a-fA-F]/g, '').toLowerCase();
      if (current.mode === 'deny' && backendHex && backendHex === m) throw new Error('WOULD_LOCK_OUT');
      const idx = ['disabled', 'allow', 'deny'].indexOf(current.mode);
      await this._req(EP.macFilter.form, {
        method: 'POST',
        body: form({
          [EP.macFilter.modeField]: String(idx < 0 ? 0 : idx),
          mac: m,
          [EP.macFilter.addAction]: 'Add',
          checkWPS2: '1',
          [EP.macFilter.submitField]: 'Send',
        }),
      });
      const after = await this.getMacFilter();
      if (!after.macs.includes(target)) throw new Error('APPLY_FAILED');
      return { ...after, added: true };
    }

    async removeMac(input) {
      const m = normalizeMac(input);
      const current = await this.getMacFilter();
      const target = fmt(m);
      if (!current.macs.includes(target)) return { ...current, removed: false };
      const idx = ['disabled', 'allow', 'deny'].indexOf(current.mode);
      await this._req(EP.macFilter.form, {
        method: 'POST',
        body: form({
          [EP.macFilter.modeField]: String(idx < 0 ? 0 : idx),
          [EP.macFilter.selField]: m,
          [EP.macFilter.delAction]: 'Delete Selected',
          [EP.macFilter.submitField]: 'Send',
        }),
      });
      const after = await this.getMacFilter();
      return { ...after, removed: !after.macs.includes(target) };
    }

    async setMacFilterMode(mode) {
      const idx = ['disabled', 'allow', 'deny'].indexOf(mode);
      if (idx < 0) throw new Error('INVALID_MODE');

      const current = await this.getMacFilter();

      // حماية 1: لا يمكن تفعيل allow/deny بدون MAC في القائمة
      if ((mode === 'allow' || mode === 'deny') && current.macs.length === 0) {
        throw new Error('MAC_LIST_EMPTY');
      }

      // حماية 2: التحقق من MAC جهازنا
      const creds = window.appStore.getCredentials() || {};
      const backendHex = (creds.backendMac || '').replace(/[^0-9a-fA-F]/g, '').toLowerCase();
      const backendFmt = backendHex.length === 12 ? fmt(backendHex) : null;

      if (!backendFmt && (mode === 'allow' || mode === 'deny')) {
        throw new Error('BACKEND_MAC_UNKNOWN');
      }

      if (backendFmt) {
        if (mode === 'deny' && current.macs.includes(backendFmt)) {
          // احذف جهازنا من القائمة قبل deny
          console.log('[safety] removing backend MAC before deny');
          await this.removeMac(backendFmt);
        } else if (mode === 'allow' && !current.macs.includes(backendFmt)) {
          // أضف جهازنا للقائمة قبل allow
          console.log('[safety] adding backend MAC before allow');
          await this.addMac(backendFmt);
        }
      }

      // حفظ الوضع الحالي كـ snapshot
      window.appStore.set('snapshot-macmode-before', { at: Date.now(), mode: current.mode, macs: current.macs });

      await this._req(EP.macFilter.form, {
        method: 'POST',
        body: form({
          [EP.macFilter.modeField]: String(idx),
          checkWPS2: '1',
          setFilterMode: 'Apply Changes',
          [EP.macFilter.submitField]: 'Send',
        }),
      });
      const after = await this.getMacFilter();
      if (after.mode !== mode) throw new Error('APPLY_FAILED');
      return after;
    }

    async emergencyReset() {
      const current = await this.getMacFilter();
      for (const m of current.macs) {
        try {
          const clean = m.replace(/[^0-9a-fA-F]/g, '').toLowerCase();
          await this._req(EP.macFilter.form, {
            method: 'POST',
            body: form({
              [EP.macFilter.modeField]: '2',
              [EP.macFilter.selField]: clean,
              [EP.macFilter.delAction]: 'Delete Selected',
              [EP.macFilter.submitField]: 'Send',
            }),
          });
        } catch (e) {}
      }
      await this.setMacFilterMode('disabled');
      return this.getMacFilter();
    }

    // ── WiFi ──
    async getWifiSettings() {
      const [basic, security] = await Promise.all([
        this._req(EP.wifi.basicPage),
        this._req(EP.wifi.securityPage),
      ]);
      const ssid = field(basic.body, EP.basicFields.ssid);
      const method = this._readMethodSmart(security.body);
      const encryption = EP.methodToName[method] || null;
      return { ssid, encryption, method, supported: Object.keys(EP.encryptionMap) };
    }

    _readMethodSmart(html) {
      const postCalls = [...html.matchAll(/postSecurity\(\s*(\d+)\s*,/gi)].map(m => Number(m[1]));
      let ssidIdx = 0;
      for (const m of html.matchAll(/<input[^>]*name\s*=\s*["']?wpaSSID["']?[^>]*value\s*=\s*["']?(\d+)["']?[^>]*>/gi)) {
        if (/\schecked/i.test(m[0])) { ssidIdx = Number(m[1]); break; }
      }
      if (postCalls.length > 0) {
        return ssidIdx < postCalls.length ? postCalls[ssidIdx] : postCalls[0];
      }
      const sel = html.match(/<select[^>]*name\s*=\s*["']?method["']?[^>]*>([\s\S]*?)<\/select>/i);
      if (sel) {
        const o = sel[1].match(/<option[^>]*value\s*=\s*["']?([^"'\s>]*)["']?[^>]*selected/i);
        if (o) return Number(o[1]);
      }
      return 0;
    }

    async setSSID(name) {
      const clean = String(name || '').trim();
      if (!clean || clean.length > 32) throw new Error('INVALID_SSID');
      const page = await this._req(EP.wifi.basicPage);
      const body = form({
        [EP.basicFields.ssid]: clean,
        [EP.basicFields.band]: field(page.body, 'band') || '10',
        [EP.basicFields.mode]: field(page.body, 'mode') || '0',
        [EP.basicFields.chanwid]: field(page.body, 'chanwid') || '2',
        [EP.basicFields.chan]: field(page.body, 'chan') || '0',
        [EP.basicFields.txpower]: field(page.body, 'txpower') || '0',
        [EP.basicFields.basicrates]: '0',
        [EP.basicFields.operrates]: '0',
        [EP.basicFields.submit]: 'Send',
      });
      await this._req(EP.wifi.setupForm, { method: 'POST', body });
      await this._sleep(3000);
      const after = await this._req(EP.wifi.basicPage);
      if (!after.body.includes(clean)) throw new Error('APPLY_FAILED');
      return { ssid: clean };
    }

    async setEncryption(type) {
      const method = EP.encryptionMap[type];
      if (method === undefined) throw new Error('UNSUPPORTED');
      const page = await this._req(EP.wifi.securityPage);
      const psk = field(page.body, EP.securityFields.pskValue) || '';
      const body = form({
        [EP.securityFields.method]: String(method),
        [EP.securityFields.pskFormat]: '0',
        [EP.securityFields.pskValue]: psk === '*************' ? '' : psk,
        [EP.securityFields.wpaAuth]: '1',
        [EP.securityFields.wpaSSID]: '0',
        [EP.securityFields.checkWPS2]: '1',
        [EP.securityFields.submit]: 'Send',
      });
      await this._req(EP.wifi.securityForm, { method: 'POST', body });
      return { encryption: type };
    }

    async setWifiPassword(password) {
      const clean = String(password || '');
      if (clean.length < 8 || clean.length > 63) throw new Error('INVALID_PASSWORD');
      const page = await this._req(EP.wifi.securityPage);
      const method = field(page.body, EP.securityFields.method) || '4';
      const body = form({
        [EP.securityFields.method]: String(method),
        [EP.securityFields.pskFormat]: '0',
        [EP.securityFields.pskValue]: clean,
        [EP.securityFields.wpaAuth]: '1',
        [EP.securityFields.wpaSSID]: '0',
        [EP.securityFields.checkWPS2]: '1',
        [EP.securityFields.submit]: 'Send',
      });
      await this._req(EP.wifi.securityForm, { method: 'POST', body });
      return { ok: true };
    }

    // ── Reboot ──
    async reboot() {
      await this._req(EP.reboot.page);
      try {
        await this._req(EP.reboot.form, {
          method: 'POST',
          body: form({
            [EP.reboot.field]: EP.reboot.value,
            [EP.reboot.submitField]: 'Send',
          }),
        });
      } catch (e) {}
      return { ok: true, message: 'الراوتر يعيد التشغيل (~60 ثانية)' };
    }

    // ── WAN ──
    async getWanStatus() {
      const page = await this._req(EP.wan.page);
      const r = rows(page.body);
      let entry = null;
      for (const cells of r) {
        const idx = cells.findIndex(c => /^(PPPoE|PPPoA|IPoE|Bridge|1483 Routed|IPoA)$/i.test((c || '').trim()));
        if (idx < 1 || cells.length < idx + 12) continue;
        entry = {
          name: cells[idx - 1], mode: cells[idx],
          vpi: cells[idx + 1], vci: cells[idx + 2], encap: cells[idx + 3],
          napt: cells[idx + 4], igmp: cells[idx + 5], drout: cells[idx + 6],
          ip: cells[idx + 7], remoteIp: cells[idx + 8], netmask: cells[idx + 9],
          username: cells[idx + 10], status: (cells[idx + 11] || '').trim(),
        };
        break;
      }
      return { connected: !!entry && /^up$/i.test(entry.status), entry };
    }

    // ── PPPoE ──
    async getPppoeDetails() {
      const page = await this._req(EP.wan.page);
      const html = page.body;
      const calls = [...html.matchAll(/postVC\(([^)]+)\)/g)];
      let target = null;
      for (const c of calls) {
        if (c[1].includes('PPPoE')) { target = c[1]; break; }
      }
      if (!target) return { connected: false, entry: null };

      const args = [];
      let cur = '', inQuote = false;
      for (let i = 0; i < target.length; i++) {
        const ch = target[i];
        if (ch === "'" || ch === '"') { inQuote = !inQuote; cur += ch; continue; }
        if (ch === ',' && !inQuote) { args.push(cur.trim()); cur = ''; continue; }
        cur += ch;
      }
      args.push(cur.trim());

      const clean = (v) => {
        let x = String(v).trim();
        if ((x.startsWith("'") && x.endsWith("'")) || (x.startsWith('"') && x.endsWith('"'))) x = x.slice(1, -1);
        return x;
      };
      const n = (v) => { const x = Number(clean(v)); return Number.isFinite(x) ? x : 0; };

      const a = args.map(clean);
      const entry = {
        vpi: n(a[1]), vci: n(a[2]), encap: a[3], napt: a[4], mode: a[5],
        igmp: a[6], username: a[7], password: a[8], auth: n(a[9]),
        acname: a[10] || '', servicename: a[11] || '', pppType: a[12],
        idletime: n(a[13]), ipMode: n(a[14]), ip: a[15], netmask: a[16],
        remoteIp: a[17], ipUnnum: n(a[18]) === 1,
        dns1: a[20] || '', dns2: a[21] || '',
        vlanEnable: n(a[36]) === 1, vlanId: n(a[37]),
        status: a[38], droute: n(a[39]), enable: n(a[40]) === 1,
      };
      return { connected: entry.status === '3' || /^up$/i.test(entry.status), entry };
    }

    async setPppoeCredentials({ username, password }) {
      const u = String(username || '').trim();
      const p = String(password || '');
      if (!u || !p) throw new Error('BAD_REQUEST');
      const cur = await this.getPppoeDetails();
      if (!cur.entry) throw new Error('BAD_REQUEST');
      const e = cur.entry;
      const body = form({
        vpi: String(e.vpi), vci: String(e.vci),
        adslEncap: e.encap === 'LLC' ? '0' : '1',
        adslConnectionMode: '2',
        naptEnabled: e.napt === 'On' ? 'ON' : '',
        igmpEnabled: e.igmp === 'On' ? 'ON' : '',
        chEnable: e.enable ? '1' : '0',
        vlanenable: e.vlanEnable ? '1' : '0',
        vlanid: String(e.vlanId || ''),
        pppUserName: u, pppPassword: p,
        pppauth: String(e.auth || 0),
        pppacname: e.acname || '', pppservicename: e.servicename || '',
        pppConnectType: e.pppType === 'persistent' ? '0' : (e.pppType === 'dial-on-demand' ? '1' : '2'),
        pppIdleTime: String(e.idletime || ''),
        ipMode: String(e.ipMode || 0), ip: e.ip || '',
        remoteIp: e.remoteIp || '', netmask: e.netmask || '',
        dnsip1: e.dns1 || '', dnsip2: e.dns2 || '',
        droute: String(e.droute || 0),
        action: 'modify', idx: '0', connid: '13',
        'submit.htm?wan.htm': 'Send',
      });
      await this._req(EP.wanForms.adslForm, { method: 'POST', body });
      await this._sleep(5000); // PPPoE يحتاج وقتاً أطول
      return this.getPppoeDetails();
    }

    // ── Time / NTP ──
    async getTimeSettings() {
      const r = await this._req(EP.time.page);
      const html = r.body;
      const year = Number(field(html, 'year')) || 0;
      const month = Number(field(html, 'month')) || 1;
      const day = Number(field(html, 'day')) || 1;
      const hour = Number(field(html, 'hour')) || 0;
      const min = Number(field(html, 'min')) || 0;
      const sec = Number(field(html, 'sec')) || 0;
      const daylightsaving = Number(field(html, 'daylightsaving')) || 0;

      let ntpEnabled = false;
      for (const m of html.matchAll(/<input[^>]*name\s*=\s*["']?ntpstate["']?[^>]*>/gi)) {
        if (/\schecked/i.test(m[0])) {
          const v = (m[0].match(/value\s*=\s*["']?([^"'\s>]+)/i) || [])[1] || '';
          ntpEnabled = (v === 'Enable'); break;
        }
      }

      let timezone = null;
      const tzMatch = html.match(/var\s+time_zone\s*=\s*['"]([+-]?\d+)['"]/i);
      if (tzMatch) timezone = Number(tzMatch[1]);

      const gmtMatch = html.match(/GMT time:<\/th>\s*<td>\s*([^<]+)/i);
      const gmtTime = gmtMatch ? gmtMatch[1].trim() : null;

      return {
        date: { year, month, day, hour, min, sec },
        daylightsaving,
        ntp: {
          enabled: ntpEnabled,
          server1: field(html, 'ntpserver') || '',
          server2: field(html, 'ntpserver2') || '',
          interval: Number(field(html, 'ntpinterval')) || 1,
          timezone,
        },
        gmtTime,
      };
    }

    async setManualTime({ year, month, day, hour, min, sec, daylightsaving = 0 }) {
      const y = Number(year), mo = Number(month), d = Number(day);
      const h = Number(hour), mi = Number(min), se = Number(sec);
      if (!y || y < 2000 || y > 2099 || mo < 1 || mo > 12 || d < 1 || d > 31 || h < 0 || h > 23 || mi < 0 || mi > 59 || se < 0 || se > 59) {
        throw new Error('BAD_REQUEST');
      }
      await this._req(EP.time.timeForm, {
        method: 'POST',
        body: form({
          year: String(y), month: String(mo), day: String(d),
          hour: String(h), min: String(mi), sec: String(se),
          daylightsaving: String(Number(daylightsaving) || 0),
          'submit.htm?time.htm': 'Send',
        }),
      });
      await this._sleep(3000);
      return this.getTimeSettings();
    }

    async setNtp({ enabled, server1, server2, interval, timezone }) {
      const e = !!enabled;
      const s1 = String(server1 || '0.pool.ntp.org').trim().slice(0, 255);
      const s2 = String(server2 || '1.pool.ntp.org').trim().slice(0, 255);
      const iv = Math.max(1, Math.min(999, Number(interval) || 1));
      let tz = '+000';
      if (typeof timezone === 'string') tz = timezone;
      else if (typeof timezone === 'number') tz = (timezone >= 0 ? '+' : '') + String(timezone);
      await this._req(EP.time.ntpForm, {
        method: 'POST',
        body: form({
          ntpstate: e ? 'Enable' : 'Disable',
          ntpserver: s1, ntpserver2: s2,
          ntpinterval: String(iv), ntptimezone: tz,
          'submit.htm?time.htm': 'Send',
        }),
      });
      await this._sleep(3000);
      return (await this.getTimeSettings()).ntp;
    }

    async syncNtp() {
      try {
        await this._req(EP.time.ntpStartForm, { method: 'POST', body: form({ ntpstart: 'start' }) });
      } catch (e) {}
      return { ok: true };
    }

    // ═══ setSecurity — التشفير + كلمة المرور معاً ═══
    async setSecurity({ encryption, password }
) {
      const cleanPass = String(password || '');
      if (cleanPass.length < 8 || cleanPass.length > 63) {
        throw new Error('كلمة المرور يجب أن تكون 8-63 حرف');
      }

      const map = {
        'None': 0, 'WEP': 1, 'WPA-TKIP': 2, 'WPA-AES': 3,
        'WPA2-AES': 4, 'WPA2-TKIP': 5, 'WPA2-Mixed': 6,
        'WPA3': 7, 'WPA3-Mixed': 8,
      };
      const method = map[encryption];
      if (method === undefined) throw new Error('نوع تشفير غير مدعوم: ' + encryption);

      const body = form({
        [EP.securityFields.method]: String(method),
        [EP.securityFields.pskFormat]: '0',
        [EP.securityFields.pskValue]: cleanPass,
        [EP.securityFields.wpaAuth]: '1',
        [EP.securityFields.wpaSSID]: '0',
        [EP.securityFields.checkWPS2]: '1',
        [EP.securityFields.submit]: 'Send',
      });

      await this._req(EP.wifi.securityForm, { method: 'POST', body });
      await this._sleep(3000);

      return { encryption: encryption, passwordSet: true };
    }
  }

  window.TPLinkRouter = TPLinkRouter;
  console.log('[router-full] TPLinkRouter ready');
})();
